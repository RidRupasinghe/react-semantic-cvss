{
  "name": "react-semantic-cvss",
  "version": "2.0.1",
  "description": "Interactive CVSS v3.1 calculator, vector parser, and rating visualizer for React applications",
  "author": "RidRupasinghe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RidRupasinghe/react-semantic-cvss.git"
  },
  "homepage": "https://github.com/RidRupasinghe/react-semantic-cvss#readme",
  "bugs": {
    "url": "https://github.com/RidRupasinghe/react-semantic-cvss/issues"
  },
  "type": "commonjs",
  "keywords": [
    "cvss",
    "cvss-calculator",
    "cvss-3.1",
    "security",
    "vulnerability",
    "react",
    "semantic-ui",
    "calculator"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "semantic-ui-react": "^0.88.2 || ^1.0.0 || ^2.0.0",
    "styled-components": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.5",
    "styled-components": "^6.1.13",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
